# GitLab applies the LAST matching pattern, so the catch-all comes first and the
# specific team rules below override it.
#
# Without this catch-all a newly created teams/<new-team>/ folder matches no rule
# at all — meaning no required reviewer, despite the process claiming review is
# enforced here.
* @architecture-guild
teams/ @architecture-guild

# Replace these group handles with your actual GitLab groups, and add a line per
# team as teams onboard.
# teams/payments/ @team-payments
# teams/platform/ @team-platform

# Cross-cutting decisions need sign-off from the architecture group.
cross-cutting/ @architecture-guild

# Templates and CI config are guild-owned so structure stays consistent.
templates/ @architecture-guild
jerry.yaml @architecture-guild
.gitlab-ci.yml @architecture-guild
CODEOWNERS @architecture-guild

# Generated — regenerated by the pre-commit hook, reviewed as part of the MR.
index/ @architecture-guild
